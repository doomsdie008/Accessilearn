# Copy this file to .env and fill in your key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# For main_gemini.py (free tier): get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash

# Optional: change TTS language accent (see gTTS docs). Default: en (India accent = 'co.in' TLD)
TTS_LANG=en
TTS_TLD=co.in
